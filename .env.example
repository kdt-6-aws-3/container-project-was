# Spring 프로파일 (mysql | 기본값 h2)
SPRING_PROFILES_ACTIVE=mysql

# MySQL 데이터소스
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/petclinic
SPRING_DATASOURCE_USERNAME=petclinic_app
SPRING_DATASOURCE_PASSWORD=change_me

# 로그 레벨 (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL=INFO

# 환경 식별자 (로그 JSON의 env 필드)
APP_ENV=production

# JVM 옵션 (컨테이너 메모리에 맞게 조정)
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75
